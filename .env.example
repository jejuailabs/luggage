# 복사해서 .env.local로 사용한다. 비밀값에는 NEXT_PUBLIC_을 붙이지 않는다.
APP_ENV=local

# Supabase (개발 프로젝트). publishable key는 브라우저 노출용 공개 키다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀값. 클라이언트 코드에서 읽지 않는다.
SUPABASE_SERVER_SECRET=
# 스케줄러(Vercel Cron)가 작업 API를 부를 때 쓰는 Bearer 값 (16자 이상)
CRON_SECRET=
# mock 결제 알림 서명 키 (비운영 전용, 비우면 로컬 기본값)
MOCK_PAYMENT_SECRET=

# 웹 푸시(VAPID). `pnpm exec web-push generate-vapid-keys`로 만든다. 공개키만 NEXT_PUBLIC_.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@example.invalid

# 차량 관제 웹훅 서명 키 (업체와 공유, 16자 이상). 형식은 packages/integrations/src/tracking.ts 참고
TRACKING_WEBHOOK_SECRET=

# 연동 모드: mock | sandbox | live (비우면 mock, live는 production 전용)
PAYMENT_MODE=mock
NOTIFICATION_MODE=mock
MAPS_MODE=mock
WECHAT_MODE=mock

# 공개 콘텐츠·호텔 데이터: supabase | fixture (fixture는 로컬·E2E 전용)
PUBLIC_DATA_SOURCE=supabase
APP_URL=http://localhost:3000
