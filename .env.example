# 복사해서 .env.local로 사용한다. 비밀값에는 NEXT_PUBLIC_을 붙이지 않는다.
APP_ENV=local

# Supabase (개발 프로젝트). publishable key는 브라우저 노출용 공개 키다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀값. 클라이언트 코드에서 읽지 않는다.
SUPABASE_SERVER_SECRET=

# 연동 모드: mock | sandbox | live (비우면 mock, live는 production 전용)
PAYMENT_MODE=mock
NOTIFICATION_MODE=mock
MAPS_MODE=mock
WECHAT_MODE=mock
